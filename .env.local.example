# ─── Supabase ────────────────────────────────────────────────────────────────
# Public Supabase project URL — safe to expose to the browser (used by the anon client).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser; subject to RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY: service role key bypasses RLS. Used by:
#   - app/api/notify/route.ts (reading orders to send confirmation)
#   - lib/supabase-admin.ts (guarded by `import "server-only"`)
#   - scripts/seed-menu.ts (local seeding via dotenv)
# NEVER expose to the browser, NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Meta / Messenger ─────────────────────────────────────────────────────────
# Meta App ID for Messenger Extensions SDK getContext() call (public, safe to expose).
# Without it, the SDK call short-circuits to isMessengerContext=false and the
# "إتمام الطلب" button stays disabled with a note.
NEXT_PUBLIC_MESSENGER_APP_ID=

# Page access token from the Meta App → Messenger → Settings → Access Tokens.
# Used by lib/messenger-send-api.ts to POST to /me/messages. SERVER-ONLY.
PAGE_ACCESS_TOKEN=

# App secret used to verify X-Hub-Signature-256 on incoming webhooks
# (app/api/webhook/route.ts). Found in Meta App → Settings → Basic. SERVER-ONLY.
APP_SECRET=

# Webhook verification token — any random string you set in the Meta App
# Webhooks config when subscribing the page. SERVER-ONLY.
VERIFY_TOKEN=

# Base URL of this deployed webview. Used to build the "افتح المنيو" button
# URL in Messenger messages. Public (safe in NEXT_PUBLIC_*).
#   - Dev:    http://localhost:3000
#   - Prod:   https://popeye-messenger-order.vercel.app
NEXT_PUBLIC_WEBVIEW_URL=

# ─── Admin / staff ──────────────────────────────────────────────────────────
# Password required to log into /admin (and call the admin API routes).
# Pick something strong. SERVER-ONLY.
ADMIN_PASSWORD=

# Messenger PSID of the staff member who should receive a notification for
# every new order. Leave empty until captured — the system works without it.
#
# HOW TO CAPTURE:
#   1. Have the staff member send any message from their Messenger to the Page.
#   2. Look in your Vercel/terminal logs for a line like:
#        [PSID-CAPTURE] sender: 1234567890 text: hi
#      (That log line lives in app/api/webhook/route.ts — remove it once
#      STAFF_PSID is filled in, it's intentionally temporary.)
#   3. Copy the `sender` value (e.g. 1234567890) into STAFF_PSID below.
#   4. Redeploy / restart the dev server. SERVER-ONLY.
STAFF_PSID=
